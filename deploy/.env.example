# Copy to deploy/.env on the server. Never commit deploy/.env.
POSTGRES_PASSWORD=change-me-long-random

EHNGLISH_ENV=prod
# Cloudflare Access (team domain "sikoraweb" -> https://sikoraweb.cloudflareaccess.com).
# The AUD is the Access application's Application Audience tag (deploy/cf-access-app.sh prints it).
EHNGLISH_CF_ACCESS_TEAM_DOMAIN=sikoraweb
EHNGLISH_CF_ACCESS_AUD=
# Belt and braces on top of the Access policy.
EHNGLISH_ALLOWED_EMAILS=bgsikora@sikoraweb.com,talk@ruralrobbie.net
# Dashboard subject and native-speaker anchors (plan §7).
EHNGLISH_LEARNER_EMAIL=bgsikora@sikoraweb.com
EHNGLISH_ANCHOR_EMAILS=talk@ruralrobbie.net
EHNGLISH_PIPELINE_VERSION=m5.0.0

# --- M1 engines (plan §9). Leave blank to skip that engine (results are marked "skipped").
EHNGLISH_DEEPGRAM_API_KEY=
EHNGLISH_AZURE_SPEECH_KEY=
EHNGLISH_AZURE_SPEECH_REGION=eastus
# Hosted Whisper large-v3 via an OpenAI-compatible endpoint: Groq (default) or OpenAI.
EHNGLISH_WHISPER_BASE_URL=https://api.groq.com/openai/v1
EHNGLISH_WHISPER_API_KEY=
EHNGLISH_WHISPER_MODEL=whisper-large-v3
# Optional fourth voter: Google Speech-to-Text. Path inside the container (deploy/google-sa.json is
# mounted there and gitignored). Leave blank to skip.
EHNGLISH_GOOGLE_CREDENTIALS=/run/secrets/google-sa.json
# Anthropic Console key (Max plan does not cover API use).
EHNGLISH_ANTHROPIC_API_KEY=
EHNGLISH_CLAUDE_MODEL=claude-opus-5-5
